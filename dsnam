  carry_out: {x:400, y:200, w:140, h:110, label:'✅ Completing Task\n(carry out)',
    svg:`<rect x="420" y="215" width="90" height="55" rx="8" fill="#d0ebff" stroke="#1971c2" stroke-width="4"/><path d="M435 245 L455 262 L495 225" stroke="#2f9e44" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`}
};

function initImgGame() {
  imgGameIndex = 0;
  imgGameScore = 0;
  document.getElementById('imgGameHint').textContent = `Score: 0 / 6`;
  renderImgScene();
}

function renderImgScene() {
  const svg = document.getElementById('imgScene');
  svg.innerHTML = '';
  Object.entries(svgIcons).forEach(([key, spot]) => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.innerHTML = spot.svg;
    svg.appendChild(g);

    const hotspot = document.createElementNS('http://www.w3.org/2000/svg','rect');
    hotspot.setAttribute('x', spot.x);
    hotspot.setAttribute('y', spot.y);
    hotspot.setAttribute('width', spot.w);
    hotspot.setAttribute('height', spot.h);
    hotspot.setAttribute('fill', 'transparent');
    hotspot.setAttribute('class', 'img-hotspot');
    hotspot.dataset.key = key;
    hotspot.onclick = () => handleImgClick(key, hotspot);
    svg.appendChild(hotspot);
  });
  imgGameAnswered = false;
  document.getElementById('imgWordCount').textContent = Math.min(imgGameIndex+1, imgGameItems.length);
}

function playImgWord() {
  if (imgGameIndex >= imgGameItems.length) return;
  const key = imgGameItems[imgGameIndex];
  const phrase = phraseTextForKey(key);
  speakText(phrase, 1.0);
}

function handleImgClick(key, hotspotEl) {
  if (imgGameIndex >= imgGameItems.length || imgGameAnswered) return;
  const targetKey = imgGameItems[imgGameIndex];
  imgGameAnswered = true;
  if (key === targetKey) {
    hotspotEl.classList.add('correct');
    imgGameScore++;
  } else {
    hotspotEl.classList.add('incorrect');
    const correctSpot = document.querySelector(`.img-hotspot[data-key="${targetKey}"]`);
    if (correctSpot) correctSpot.classList.add('correct');
  }
  document.getElementById('imgGameHint').textContent = `Score: ${imgGameScore} / 6`;
  setTimeout(() => {
    imgGameIndex++;
    if (imgGameIndex < imgGameItems.length) {
      renderImgScene();
    } else {
      document.getElementById('imgGameHint').textContent = `🎉 Finished! Final Score: ${imgGameScore} / 6`;
    }
  }, 900);
}

