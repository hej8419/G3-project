<script>
/* ================== DATA ================== */
const expressions = [
  {key:'find_out', phrase:'find out', phonetic:'/faɪnd aʊt/', def:'to get information that you did not know before', kr:'알아내다',
    examples:["I want to find out what time the movie starts.", "The team tried to find out why the machine stopped working."]},
  {key:'set_up', phrase:'set up', phonetic:'/sɛt ʌp/', def:'to prepare and start something, like a system or business', kr:'설치하다, 설립하다',
    examples:["They plan to set up a new computer lab at school.", "We set up a tent before it got dark."]},
  {key:'sort_out', phrase:'sort out', phonetic:'/sɔːrt aʊt/', def:'to organize or separate things correctly', kr:'분류하다, 정리하다',
    examples:["Can you help me sort out these old books?", "She sorted out the laundry into two piles."]},
  {key:'pay_attention', phrase:'pay attention to', phonetic:'/peɪ əˈtɛnʃən tuː/', def:'to watch, listen to, or think about something carefully', kr:'주의를 기울이다',
    examples:["Please pay attention to the teacher during class.", "He didn't pay attention to the warning sign."]},
  {key:'come_up_with', phrase:'come up with', phonetic:'/kʌm ʌp wɪð/', def:'to think of a new idea or plan', kr:'생각해 내다',
    examples:["She came up with a great idea for the project.", "We need to come up with a plan before Friday."]},
  {key:'carry_out', phrase:'carry out', phonetic:'/ˈkæri aʊt/', def:'to do or complete a plan or task', kr:'수행하다, 실행하다',
    examples:["The team carried out the experiment successfully.", "They will carry out the survey next week."]}
];

const fillBlanks = [
  {key:'find_out', text:'find out'},
  {key:'set_up', text:'set up'},
  {key:'sort_out', text:'sort out'},
  {key:'pay_attention', text:'pay attention to'},
  {key:'come_up_with', text:'came up with'},
  {key:'carry_out', text:'carry out'}
];

const mcQuestions = [
  {sentence:"Scientists are trying to ___ why the ice caps are melting so fast.", correct:'find_out', options:['find out','carry out','sort out','set up']},
  {sentence:"My mom asked me to ___ my messy room before dinner.", correct:'sort_out', options:['sort out','pay attention to','come up with','find out']},
  {sentence:"The company plans to ___ a new online store next month.", correct:'set_up', options:['set up','carry out','find out','sort out']},
  {sentence:"Please ___ the teacher while she explains the homework.", correct:'pay_attention', options:['pay attention to','come up with','set up','sort out']},
  {sentence:"The students had to ___ a creative idea for the school festival.", correct:'come_up_with', options:['come up with','carry out','find out','pay attention to']},
  {sentence:"The scientists will ___ the experiment tomorrow morning.", correct:'carry_out', options:['carry out','set up','sort out','come up with']}
];

const stageIds = ['stage-learn','stage-match','stage-fill','stage-apply','stage-result'];
const stageNames = ['Learn','Matching Game','Fill in the Blanks','Apply','Results'];
let currentStage = 0;
let fillScore = 0, mcScore = 0;

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function phraseTextForKey(key){ return expressions.find(e=>e.key===key).phrase; }
function defTextForKey(key){ return expressions.find(e=>e.key===key).def; }

/* ================== TOP NAV / SECTION SWITCHING ================== */
const allSections = ['stage-learn','stage-match','stage-fill','stage-apply','stage-result',
  'stage-flash','stage-assess-menu','stage-assess-run','stage-assess-done','stage-imggame'];

function hideAllSections() {
  allSections.forEach(id => document.getElementById(id).classList.remove('visible'));
}

function setNavActive(which) {
  ['navMain','navFlash','navAssess','navImg'].forEach(id => document.getElementById(id).classList.remove('active'));
  const map = {main:'navMain', flash:'navFlash', assess:'navAssess', imggame:'navImg'};
  document.getElementById(map[which]).classList.add('active');
}

function goHome(section) {
  hideAllSections();
  setNavActive(section);
  const progressTrack = document.getElementById('progressTrack');
  const stageLabel = document.getElementById('stageLabel');
  if (section === 'main') {
    document.getElementById(stageIds[currentStage]).classList.add('visible');
    progressTrack.style.display = 'flex';
    stageLabel.style.display = 'block';
    updateProgress();
  } else if (section === 'flash') {
    document.getElementById('stage-flash').classList.add('visible');
    progressTrack.style.display = 'none';
    stageLabel.textContent = 'Flashcards';
    stageLabel.style.display = 'block';
    renderFlashcard();
  } else if (section === 'assess') {
    document.getElementById('stage-assess-menu').classList.add('visible');
    progressTrack.style.display = 'none';
    stageLabel.textContent = 'Assessment Center';
  } else if (section === 'imggame') {
    document.getElementById('stage-imggame').classList.add('visible');
    progressTrack.style.display = 'none';
    stageLabel.textContent = 'Listen & Find Game';
    initImgGame();
  }
  window.scrollTo({top:0, behavior:'smooth'});
}

function buildProgress() {
  const track = document.getElementById('progressTrack');
  track.innerHTML = '';
  stageIds.forEach(() => {
    const seg = document.createElement('div');
    seg.className = 'progress-seg';
    track.appendChild(seg);
  });
  updateProgress();
}

function updateProgress() {
  const segs = document.querySelectorAll('.progress-seg');
  segs.forEach((seg, i) => {
    seg.classList.remove('done','active');
    if (i < currentStage) seg.classList.add('done');
    else if (i === currentStage) seg.classList.add('active');
  });
  document.getElementById('stageLabel').textContent = `Step ${currentStage+1} of 5: ${stageNames[currentStage]}`;
}

function goToStage(index) {
  hideAllSections();
  setNavActive('main');
  currentStage = index;
  document.getElementById(stageIds[currentStage]).classList.add('visible');
  document.getElementById('progressTrack').style.display = 'flex';
  document.getElementById('stageLabel').style.display = 'block';
  updateProgress();
  window.scrollTo({top:0, behavior:'smooth'});
  if (stageIds[currentStage] === 'stage-result') showResult();
}

/* ================== STAGE 1: LEARN ================== */
function renderMeanings() {
  const grid = document.getElementById('meaningGrid');
  grid.innerHTML = expressions.map(e => `
    <div class="meaning-card">
      <div class="phrase">${e.phrase}</div>
      <div class="def">${e.def}</div>
      <div class="kr">${e.kr}</div>
    </div>
  `).join('');
}

/* ================== STAGE 2: MATCH ================== */
let matchSelectedLeft = null, matchSelectedRight = null, matchesDone = 0;

function renderMatch() {
  const leftCol = document.getElementById('matchLeftCol');
  const rightCol = document.getElementById('matchRightCol');
  leftCol.innerHTML = '';
  rightCol.innerHTML = '';

  expressions.forEach(e => {
    const btn = document.createElement('button');
    btn.className = 'match-btn';
    btn.textContent = e.phrase;
    btn.dataset.key = e.key;
    btn.onclick = () => handleMatchClick(btn, 'left');
    leftCol.appendChild(btn);
  });

  shuffle(expressions).forEach(e => {
    const btn = document.createElement('button');
    btn.className = 'match-btn';
    btn.textContent = e.def;
    btn.dataset.key = e.key;
    btn.onclick = () => handleMatchClick(btn, 'right');
    rightCol.appendChild(btn);
  });
}

function handleMatchClick(btn, side) {
  if (btn.classList.contains('matched')) return;
  if (side === 'left') {
    if (matchSelectedLeft) matchSelectedLeft.classList.remove('selected');
    matchSelectedLeft = btn;
    btn.classList.add('selected');
  } else {
    if (matchSelectedRight) matchSelectedRight.classList.remove('selected');
    matchSelectedRight = btn;
    btn.classList.add('selected');
  }
  if (matchSelectedLeft && matchSelectedRight) {
    if (matchSelectedLeft.dataset.key === matchSelectedRight.dataset.key) {
      matchSelectedLeft.classList.remove('selected');
      matchSelectedRight.classList.remove('selected');
      matchSelectedLeft.classList.add('matched');
      matchSelectedRight.classList.add('matched');
      matchesDone++;
      document.getElementById('matchHint').textContent = `Matched: ${matchesDone} / 6`;
      if (matchesDone === 6) {
        document.getElementById('matchNextBtn').disabled = false;
        document.getElementById('matchHint').textContent = `All matched! 🎉`;
      }
      matchSelectedLeft = null;
      matchSelectedRight = null;
    } else {
      const l = matchSelectedLeft, r = matchSelectedRight;
      l.classList.add('wrong-flash');
      r.classList.add('wrong-flash');
      setTimeout(() => {
        l.classList.remove('selected','wrong-flash');
        r.classList.remove('selected','wrong-flash');
      }, 400);
      matchSelectedLeft = null;
      matchSelectedRight = null;
    }
  }
}

/* ================== STAGE 3: FILL ================== */
let selectedBankWord = null;
let filledBlanks = {};

function renderFill() {
  const passageEl = document.getElementById('fillPassage');
  passageEl.innerHTML =
    `A group of students wanted to <span class="blank empty" data-key="find_out" onclick="handleBlankClick(this)"></span> how much waste their school produced each day. ` +
    `They decided to <span class="blank empty" data-key="set_up" onclick="handleBlankClick(this)"></span> recycling boxes for paper and plastic. ` +
    `They also asked classmates to <span class="blank empty" data-key="sort_out" onclick="handleBlankClick(this)"></span> their waste carefully. ` +
    `At first, many students did not <span class="blank empty" data-key="pay_attention" onclick="handleBlankClick(this)"></span> the recycling signs, ` +
    `so the team <span class="blank empty" data-key="come_up_with" onclick="handleBlankClick(this)"></span> a simple points game. ` +
    `With more students joining the project, the team was able to <span class="blank empty" data-key="carry_out" onclick="handleBlankClick(this)"></span> the plan for an entire month.`;

  const bank = document.getElementById('wordBank');
  bank.innerHTML = '';
  shuffle(fillBlanks).forEach(w => {
    const b = document.createElement('button');
    b.className = 'bank-word';
    b.textContent = w.text;
    b.dataset.key = w.key;
    b.dataset.text = w.text;
    b.onclick = () => handleBankClick(b);
    bank.appendChild(b);
  });
  updateFillHint();
}

function handleBankClick(btn) {
  if (btn.disabled) return;
  if (selectedBankWord) selectedBankWord.classList.remove('selected');
  if (selectedBankWord === btn) { selectedBankWord = null; return; }
  selectedBankWord = btn;
  btn.classList.add('selected');
}

function handleBlankClick(blankEl) {
  const blankKey = blankEl.dataset.key;
  if (filledBlanks[blankKey]) {
    const info = filledBlanks[blankKey];
    info.buttonEl.disabled = false;
    delete filledBlanks[blankKey];
    blankEl.classList.add('empty');
    blankEl.textContent = '';
    updateFillHint();
    return;
  }
  if (!selectedBankWord) return;
  filledBlanks[blankKey] = {
    key: selectedBankWord.dataset.key,
    text: selectedBankWord.dataset.text,
    buttonEl: selectedBankWord
  };
  blankEl.classList.remove('empty');
  blankEl.textContent = selectedBankWord.dataset.text;
  selectedBankWord.disabled = true;
  selectedBankWord.classList.remove('selected');
  selectedBankWord = null;
  updateFillHint();
}

function updateFillHint() {
  const count = Object.keys(filledBlanks).length;
  document.getElementById('fillHint').textContent = `Filled: ${count} / 6`;
  document.getElementById('checkFillBtn').disabled = (count < 6);
}

function checkFill() {
  fillScore = 0;
  document.querySelectorAll('.blank').forEach(blankEl => {
    const blankKey = blankEl.dataset.key;
    const filled = filledBlanks[blankKey];
    const isCorrect = filled && filled.key === blankKey;
    if (isCorrect) {
      fillScore++;
      blankEl.classList.add('correct');
    } else {
      blankEl.classList.add('incorrect');
      const correctText = fillBlanks.find(f => f.key === blankKey).text;
      const fix = document.createElement('span');
      fix.className = 'fix';
      fix.textContent = `✓ ${correctText}`;
      blankEl.appendChild(fix);
    }
  });
  document.getElementById('fillHint').textContent = `Score: ${fillScore} / 6`;
  document.getElementById('checkFillBtn').style.display = 'none';
  document.getElementById('fillNextBtn').style.display = 'inline-block';
  document.querySelectorAll('.bank-word').forEach(b => b.disabled = true);
}

/* ================== STAGE 4: APPLY (MC) ================== */
let mcAnswers = {};

function renderMc() {
  const container = document.getElementById('mcContainer');
  container.innerHTML = '';
  mcQuestions.forEach((q, i) => {
    const div = document.createElement('div');
    div.className = 'mc-question';
    div.innerHTML = `
      <div class="qnum">Question ${i+1} of 6</div>
      <div class="sentence">${q.sentence}</div>
      <div class="mc-options" id="mcOpts-${i}"></div>
    `;
    container.appendChild(div);
    const optsWrap = div.querySelector(`#mcOpts-${i}`);
    q.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'mc-opt';
      btn.textContent = opt;
      btn.onclick = () => handleMcClick(i, opt, btn);
      optsWrap.appendChild(btn);
    });
  });
  updateMcHint();
}

function handleMcClick(qIndex, optText, btnEl) {
  const parent = btnEl.parentElement;
  Array.from(parent.children).forEach(c => c.classList.remove('chosen'));
  btnEl.classList.add('chosen');
  mcAnswers[qIndex] = optText;
  updateMcHint();
}

function updateMcHint() {
  const count = Object.keys(mcAnswers).length;
  document.getElementById('mcHint').textContent = `Answered: ${count} / 6`;
  document.getElementById('submitMcBtn').disabled = (count < 6);
}

function checkMc() {
  mcScore = 0;
  mcQuestions.forEach((q, i) => {
    const correctText = phraseTextForKey(q.correct);
    const chosenText = mcAnswers[i];
    const parent = document.getElementById(`mcOpts-${i}`);
    Array.from(parent.children).forEach(btn => {
      btn.disabled = true;
      if (btn.textContent === correctText) {
        btn.classList.add('correct-answer');
      } else if (btn.textContent === chosenText && chosenText !== correctText) {
        btn.classList.add('wrong-chosen');
      }
    });
    if (chosenText === correctText) mcScore++;
  });
  document.getElementById('mcHint').textContent = `Score: ${mcScore} / 6`;
  document.getElementById('submitMcBtn').style.display = 'none';
  document.getElementById('mcNextBtn').style.display = 'inline-block';
}

