/* ---- Pronunciation Assessment (Web Speech API recognition) ---- */
let recognition = null;
let isRecording = false;

function getRecognition() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return null;
  const r = new SR();
  r.lang = 'en-US';
  r.interimResults = false;
  r.maxAlternatives = 1;
  return r;
}

function similarity(a, b) {
  a = a.toLowerCase().trim(); b = b.toLowerCase().trim();
  const wordsA = a.split(/\s+/), wordsB = b.split(/\s+/);
  const setB = new Set(wordsB);
  let matches = 0;
  wordsA.forEach(w => { if (setB.has(w)) matches++; });
  const denom = Math.max(wordsA.length, wordsB.length);
  let wordScore = denom ? matches / denom : 0;

  // character-level Levenshtein-based similarity as a secondary signal
  const dist = levenshtein(a, b);
  const charScore = 1 - dist / Math.max(a.length, b.length, 1);

  return Math.max(0, Math.min(1, (wordScore * 0.6 + charScore * 0.4)));
}

function levenshtein(a, b) {
  const m = a.length, n = b.length;
  const dp = Array.from({length:m+1}, () => new Array(n+1).fill(0));
  for (let i=0;i<=m;i++) dp[i][0]=i;
  for (let j=0;j<=n;j++) dp[0][j]=j;
  for (let i=1;i<=m;i++){
    for (let j=1;j<=n;j++){
      if (a[i-1]===b[j-1]) dp[i][j]=dp[i-1][j-1];
      else dp[i][j]=1+Math.min(dp[i-1][j-1], dp[i-1][j], dp[i][j-1]);
    }
  }
  return dp[m][n];
}

function toggleRecording() {
  const target = expressions[fcIndex].phrase;
  const resultDiv = document.getElementById('pronResult');
  const micBtn = document.getElementById('micBtn');

  if (isRecording) {
    if (recognition) recognition.stop();
    return;
  }

  recognition = getRecognition();
  if (!recognition) {
    resultDiv.innerHTML = `<div class="pron-heard">⚠️ Speech recognition is not supported in this browser. Try Chrome on desktop or Android.</div>`;
    return;
  }

  isRecording = true;
  micBtn.classList.add('recording');
  micBtn.textContent = '⏹️ Stop Recording';
  resultDiv.innerHTML = `<div class="pron-heard">🎧 Listening... say: "${target}"</div>`;

  recognition.onresult = (event) => {
    const heard = event.results[0][0].transcript;
    const score = Math.round(similarity(heard, target) * 100);
    let cls = 'low';
    if (score >= 80) cls = 'good';
    else if (score >= 55) cls = 'mid';
    resultDiv.innerHTML = `
      <div>Accuracy: <span class="pron-score ${cls}">${score}%</span></div>
      <div class="pron-heard">We heard: "${heard}"</div>
      <div class="pron-heard">Target: "${target}"</div>
    `;
  };

  recognition.onerror = (event) => {
    resultDiv.innerHTML = `<div class="pron-heard">⚠️ Could not recognize speech (${event.error}). Please try again.</div>`;
  };

  recognition.onend = () => {
    isRecording = false;
    micBtn.classList.remove('recording');
    micBtn.textContent = '🎤 Start Recording';
  };

  recognition.start();
}

/* ================== ASSESSMENT CENTER ================== */
let assessMode = '';         // 'spelling' | 'word' | 'meaning' | 'mixed'
let assessQueue = [];        // array of {key, type}
let assessRoundResults = []; // per-item correctness this round
let assessIncorrectPool = []; // keys+type to retake
let isRetakeRound = false;

function startAssessment(mode) {
  assessMode = mode;
  isRetakeRound = false;
  const keys = shuffle(expressions.map(e => e.key));
  assessQueue = keys.map(k => ({
    key: k,
    type: mode === 'mixed' ? ['spelling','word','meaning'][Math.floor(Math.random()*3)] : mode
  }));
  runAssessmentRound();
}

function runAssessmentRound() {
  hideAllSections();
  setNavActive('assess');
  document.getElementById('stage-assess-run').classList.add('visible');

  const titleMap = {spelling:'✍️ Spelling Assessment', word:'🔤 Word Selection', meaning:'💡 Meaning Selection', mixed:'🎲 Mixed Review'};
  document.getElementById('assessTitle').textContent = titleMap[assessMode] || '🧪 Assessment';

  const instrMap = {
    spelling: 'Read the meaning and type the correct expression in English.',
    word: 'Read the meaning and choose the correct expression.',
    meaning: 'Read the expression and choose the correct meaning.',
    mixed: 'Answer each question — the type may change each time!'
  };
  document.getElementById('assessInstructions').innerHTML = `${instrMap[assessMode]} <span class="kr">뜻을 읽고 정답을 고르거나 입력하세요.</span>`;

  const bannerWrap = document.getElementById('retakeBannerWrap');
  bannerWrap.innerHTML = isRetakeRound
    ? `<div class="retake-banner">🔁 Retake Round: You are only reviewing the ${assessQueue.length} word(s) you got wrong. Order is randomized. The session finishes once these are all correct.</div>`
    : '';

  const container = document.getElementById('assessContainer');
  container.innerHTML = '';
  assessRoundResults = new Array(assessQueue.length).fill(null);

  assessQueue.forEach((item, i) => {
    const e = expressions.find(x => x.key === item.key);
    const div = document.createElement('div');
    div.className = 'spell-item';
    div.dataset.index = i;

    if (item.type === 'spelling') {
      div.innerHTML = `
        <div class="prompt">Q${i+1}. Meaning: <b>${e.def}</b> (${e.kr})</div>
        <input type="text" class="spell-input" id="ans-${i}" placeholder="Type the English expression..." autocomplete="off">
        <div class="spell-feedback" id="fb-${i}"></div>
      `;
    } else if (item.type === 'word') {
      const opts = shuffle([e.phrase, ...shuffle(expressions.filter(x=>x.key!==e.key)).slice(0,3).map(x=>x.phrase)]);
      div.innerHTML = `
        <div class="prompt">Q${i+1}. Meaning: <b>${e.def}</b> (${e.kr})</div>
        <div class="mc-options" id="wordopts-${i}"></div>
        <div class="spell-feedback" id="fb-${i}"></div>
      `;
      container.appendChild(div);
      const optsWrap = div.querySelector(`#wordopts-${i}`);
      opts.forEach(opt => {
        const b = document.createElement('button');
        b.className = 'mc-opt';
        b.textContent = opt;
        b.onclick = () => {
          Array.from(optsWrap.children).forEach(c => c.classList.remove('chosen'));
          b.classList.add('chosen');
          optsWrap.dataset.chosen = opt;
        };
        optsWrap.appendChild(b);
      });
      return;
    } else if (item.type === 'meaning') {
      const correctDef = e.def;
      const opts = shuffle([correctDef, ...shuffle(expressions.filter(x=>x.key!==e.key)).slice(0,3).map(x=>x.def)]);
      div.innerHTML = `
        <div class="prompt">Q${i+1}. Expression: <b>${e.phrase}</b></div>
        <div class="mc-options" id="meanopts-${i}"></div>
        <div class="spell-feedback" id="fb-${i}"></div>
      `;
      container.appendChild(div);
      const optsWrap = div.querySelector(`#meanopts-${i}`);
      opts.forEach(opt => {
        const b = document.createElement('button');
        b.className = 'mc-opt';
        b.textContent = opt;
        b.onclick = () => {
          Array.from(optsWrap.children).forEach(c => c.classList.remove('chosen'));
          b.classList.add('chosen');
          optsWrap.dataset.chosen = opt;
        };
        optsWrap.appendChild(b);
      });
      return;
    }
    container.appendChild(div);
  });

  document.getElementById('assessHint').textContent = `${assessQueue.length} question(s)`;
  document.getElementById('assessSubmitBtn').textContent = 'Check Answers';
  document.getElementById('assessSubmitBtn').disabled = false;
  document.getElementById('assessSubmitBtn').onclick = submitAssessmentRound;
}

function submitAssessmentRound() {
  let correctCount = 0;
  const wrongItems = [];

  assessQueue.forEach((item, i) => {
    const e = expressions.find(x => x.key === item.key);
    const fb = document.getElementById(`fb-${i}`);
    let isCorrect = false;
    let userAnswerText = '';

    if (item.type === 'spelling') {
      const input = document.getElementById(`ans-${i}`);
      userAnswerText = input.value.trim();
      isCorrect = userAnswerText.toLowerCase() === e.phrase.toLowerCase();
      input.disabled = true;
      input.classList.add(isCorrect ? 'correct' : 'incorrect');
      fb.className = 'spell-feedback ' + (isCorrect ? 'correct' : 'incorrect');
      fb.textContent = isCorrect ? '✅ Correct!' : `❌ Incorrect — correct answer: "${e.phrase}"`;
    } else if (item.type === 'word') {
      const optsWrap = document.getElementById(`wordopts-${i}`);
      userAnswerText = optsWrap.dataset.chosen || '';
      isCorrect = userAnswerText === e.phrase;
      Array.from(optsWrap.children).forEach(btn => {
        btn.disabled = true;
        if (btn.textContent === e.phrase) btn.classList.add('correct-answer');
        else if (btn.textContent === userAnswerText) btn.classList.add('wrong-chosen');
      });
      fb.className = 'spell-feedback ' + (isCorrect ? 'correct' : 'incorrect');
      fb.textContent = isCorrect ? '✅ Correct!' : `❌ Incorrect — correct answer: "${e.phrase}"`;
    } else if (item.type === 'meaning') {
      const optsWrap = document.getElementById(`meanopts-${i}`);
      userAnswerText = optsWrap.dataset.chosen || '';
      isCorrect = userAnswerText === e.def;
      Array.from(optsWrap.children).forEach(btn => {
        btn.disabled = true;
        if (btn.textContent === e.def) btn.classList.add('correct-answer');
        else if (btn.textContent === userAnswerText) btn.classList.add('wrong-chosen');
      });
      fb.className = 'spell-feedback ' + (isCorrect ? 'correct' : 'incorrect');
      fb.textContent = isCorrect ? '✅ Correct!' : `❌ Incorrect — correct meaning: "${e.def}"`;
    }

    assessRoundResults[i] = isCorrect;
    if (isCorrect) correctCount++;
    else wrongItems.push(item);
  });

  document.getElementById('assessHint').textContent = `Score: ${correctCount} / ${assessQueue.length}`;
  document.getElementById('assessSubmitBtn').textContent = wrongItems.length > 0 ? 'Continue to Retake →' : 'Finish ✔';
  document.getElementById('assessSubmitBtn').onclick = () => {
    if (wrongItems.length > 0) {
      // build retake queue: only incorrect words, randomized, re-randomize their question type if mixed
      assessQueue = shuffle(wrongItems).map(item => ({
        key: item.key,
        type: assessMode === 'mixed' ? ['spelling','word','meaning'][Math.floor(Math.random()*3)] : item.type
      }));
      isRetakeRound = true;
      runAssessmentRound();
    } else {
      finishAssessment();
    }
  };
}

function finishAssessment() {
  hideAllSections();
  document.getElementById('stage-assess-done').classList.add('visible');
  document.getElementById('assessScoreCircle').style.setProperty('--pct','100%');
  document.getElementById('assessScoreNum').textContent = `${expressions.length}/${expressions.length}`;
}

/* ================== IMAGE / AUDIO GAME ================== */
